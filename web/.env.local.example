# ================================================================
# SGOHA Web (Next.js) - Variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# .env.local esta en .gitignore por defecto en Next.js. Nunca lo commitees.
# ================================================================

# Supabase - Project Settings > API
# URL del proyecto (ejemplo: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Anon (public) key - se puede exponer en el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Solo para bootstrap administrativo del proyecto.
# Nunca exponerlo al cliente ni commitearlo.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
