// SGOHA - Esquema Prisma
// Esqueleto inicial para Sprint 0. Los modelos completos se elaboran
// en Sprint 1-2 cuando se implementen los modulos de Auth, Registro,
// Disponibilidad, Matricula y Motor CSP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINADOR
  DOCENTE
  ESTUDIANTE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Period {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  startDate       DateTime
  endDate         DateTime
  enrollmentStart DateTime
  enrollmentEnd   DateTime
  createdAt       DateTime @default(now())
}

model Course {
  id      String @id @default(cuid())
  code    String @unique
  name    String
  credits Int
}

model Classroom {
  id       String @id @default(cuid())
  code     String @unique
  capacity Int
}
