# ================================================================
# SGOHA Backend - Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el .env (esta en .gitignore).
# ================================================================

# PostgreSQL (RNF-09: configuracion via env vars, docker-compose)
DATABASE_URL="postgresql://sgoha:sgoha_dev@localhost:5432/sgoha?schema=public"

# Autenticacion JWT (RF-02: expiracion configurable, default 8h)
JWT_SECRET="reemplazar_con_secreto_aleatorio_en_produccion"
JWT_EXPIRES_IN="8h"

# Bcrypt (RNF-04: cost factor >= 12)
BCRYPT_ROUNDS=12

# Servidor
PORT=3001
NODE_ENV=development

# CORS (RNF-08: SPA en Chrome/Firefox/Edge)
CORS_ORIGIN="http://localhost:5173"

# Microservicio CSP (RF-07: motor de Satisfaccion de Restricciones)
CSP_SERVICE_URL="http://localhost:8000"
