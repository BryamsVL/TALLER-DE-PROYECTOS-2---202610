# ================================================================
# SGOHA Backend - Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el .env (esta en .gitignore).
# ================================================================

# PostgreSQL via Supabase (hosted)
# DATABASE_URL: connection pooler (puerto 6543, usado en runtime)
# DIRECT_URL:   conexion directa (puerto 5432, usado por prisma migrate)
# Obtener ambas en: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Autenticacion JWT (RF-02: expiracion configurable, default 8h)
JWT_SECRET="reemplazar_con_secreto_aleatorio_en_produccion"
JWT_EXPIRES_IN="8h"

# Bcrypt (RNF-04: cost factor >= 12)
BCRYPT_ROUNDS=12

# Servidor
PORT=3001
NODE_ENV=development

# CORS (RNF-08: SPA en Chrome/Firefox/Edge)
CORS_ORIGIN="http://localhost:5173"

# Microservicio CSP (RF-07: motor de Satisfaccion de Restricciones)
# DIFERIDO a Sprint 2-3. Cuando se reactive, descomentar y desplegar el servicio Python.
# CSP_SERVICE_URL="http://localhost:8000"
# FEATURE_CSP_ENABLED=false
